MinHook 1.3.4 (c3fcafdc10146beb5919319d0683e44e3c30d537): queued context ordering

Suspend without relocating for MH_ApplyQueued. Relocate each committed hook
while all frozen threads remain suspended. Failed and unattempted hooks leave
thread contexts unchanged; earlier successful hooks retain their relocations.
This changes only queued application, not the direct/all-hooks/remove APIs.
The upstream BSD license and copyright remain in src/hook.c.

diff --git a/src/hook.c b/src/hook.c
--- a/src/hook.c
+++ b/src/hook.c
@@ -52,5 +52,7 @@
 #define ACTION_DISABLE      0
 #define ACTION_ENABLE       1
 #define ACTION_APPLY_QUEUED 2
+#define ACTION_FREEZE_ONLY  3
+#define ACTION_COMMITTED    4
 
 // Thread access rights for suspending/resuming threads.
@@ -244,5 +246,5 @@
             break;
         }
-        if (pHook->isEnabled == enable)
+        if (pHook->isEnabled == enable && action != ACTION_COMMITTED)
             continue;
 
@@ -349,6 +351,7 @@
                 if (result != 0xFFFFFFFF)
                 {
                     suspended = TRUE;
-                    ProcessThreadIPs(hThread, pos, action);
+                    if (action != ACTION_FREEZE_ONLY)
+                        ProcessThreadIPs(hThread, pos, action);
                 }
                 CloseHandle(hThread);
@@ -367,4 +370,23 @@
 
 //-------------------------------------------------------------------------
+static VOID ProcessCommittedThreadIPs(PFROZEN_THREADS pThreads, UINT pos)
+{
+    UINT i;
+    for (i = 0; i < pThreads->size; ++i)
+    {
+        if (pThreads->pItems[i] != 0)
+        {
+            HANDLE hThread = OpenThread(THREAD_ACCESS, FALSE, pThreads->pItems[i]);
+            if (hThread != NULL)
+            {
+                // EnableHookLL has committed isEnabled and queueEnable.
+                ProcessThreadIPs(hThread, pos, ACTION_COMMITTED);
+                CloseHandle(hThread);
+            }
+        }
+    }
+}
+
+//-------------------------------------------------------------------------
 static VOID Unfreeze(PFROZEN_THREADS pThreads)
 {
@@ -853,5 +875,5 @@
         {
             FROZEN_THREADS threads;
-            status = Freeze(&threads, ALL_HOOKS_POS, ACTION_APPLY_QUEUED);
+            status = Freeze(&threads, ALL_HOOKS_POS, ACTION_FREEZE_ONLY);
             if (status == MH_OK)
             {
@@ -863,5 +885,8 @@
                         status = EnableHookLL(i, pHook->queueEnable);
                         if (status != MH_OK)
                             break;
+
+                        // Never relocate a thread for a patch that failed.
+                        ProcessCommittedThreadIPs(&threads, i);
                     }
                 }
